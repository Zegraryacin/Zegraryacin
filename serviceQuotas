import { Injectable } from '@angular/core';
import { HttpClient, HttpParams } from '@angular/common/http';
import { Observable } from 'rxjs';

import { Quota } from '../models/quota.model';
import { CreationQuotaRequest } from '@app/gestion-quotas-rdv-visio/models/creation-quota-request.model';
import { CreationQuotaResponse } from '@app/gestion-quotas-rdv-visio/models/creation-quota-response.model';
import { Agence } from '@app/gestion-quotas-rdv-visio/models/agence.model';
import { environment } from '@env/environment';

const SERVICE_QUOTAS_PATHS = {
    LIST: `${environment.urlBack}/quota/quotas`,
    CREATE: `${environment.urlBack}/quota/quotas`,
    DELETE: `${environment.urlBack}/quota/quotas`,
    AGENCES: `${environment.urlBack}/quota/agences-list`
};

@Injectable({
    providedIn: 'root'
})
export class QuotaService {
    constructor(private http: HttpClient) {}

    listerQuotas(
        structure: string,
        dateDebut: string,
        dateFin: string,
        statutQuota?: string
    ): Observable<Quota[]> {
        let params = new HttpParams()
            .set('structure', structure)
            .set('dateDebut', dateDebut)
            .set('dateFin', dateFin);

        if (statutQuota) {
            params = params.set('statutQuota', statutQuota);
        }

        return this.http.get<Quota[]>(SERVICE_QUOTAS_PATHS.LIST, { params });
    }

    creationQuota(request: CreationQuotaRequest): Observable<CreationQuotaResponse> {
        return this.http.post<CreationQuotaResponse>(SERVICE_QUOTAS_PATHS.CREATE, request);
    }

    suppressionQuota(idQuota: string): Observable<void> {
        return this.http.delete<void>(`${SERVICE_QUOTAS_PATHS.DELETE}/${idQuota}`);
    }

    loadAgences(): Observable<Agence[]> {
        return this.http.get<Agence[]>(SERVICE_QUOTAS_PATHS.AGENCES);
    }

    loadRegions(): Observable<Agence[]> {
        return this.http.get<Agence[]>(`${environment.urlBack}/quota/regions`);
    }

    loadZones(region: string): Observable<Agence[]> {
        return this.http.get<Agence[]>(`${environment.urlBack}/quota/zones/${region}`);
    }

    loadAgencesZone(zone: string): Observable<Agence[]> {
        return this.http.get<Agence[]>(`${environment.urlBack}/quota/agences-zone/${zone}`);
    }

    loadCascade(
        type: string,
        code: string,
        statutQuota?: 'A' | 'I'
    ): Observable<Quota[]> {
        let params = new HttpParams()
            .set('type', type)
            .set('code', code);

        if (statutQuota !== undefined) {
            params = params.set('statutQuota', statutQuota);
        }

        return this.http.get<Quota[]>(
            `${environment.urlBack}/quota/quotas-cascade`,
            { params }
        );
    }

    loadAllZones(): Observable<Agence[]> {
        return this.http.get<Agence[]>(`${environment.urlBack}/quota/zones`);
    }

    loadAgencesRegion(region: string): Observable<Agence[]> {
        return this.http.get<Agence[]>(`${environment.urlBack}/quota/agences-region/${region}`);
    }
}