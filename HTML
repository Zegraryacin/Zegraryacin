<ng-container *ngFor="let code of Constantes.HAB_EDITION_DOCUMENTS">

    <div *ngIf="isWithEdition(code)">

        <!-- CAS SPECIAL : MODELE DE RESILIATION -->
        <ng-container
            *ngIf="
                code === Constantes.HAB_EDITION_MODEL_RESILIATION;
                else editionStandard
            ">

            <div class="modele-resiliation-container">

                <div class="checkbox">

                    <input
                        id="modeleResiliation"
                        name="modeleResiliation"
                        type="checkbox"
                        [(ngModel)]="modeleResiliationSelectionne"
                        [disabled]="isDocumentEnvoye(code)" />

                    <label
                        class="label"
                        for="modeleResiliation">

                        Modèle de lettre de résiliation Loi Hamon Propriétaire

                    </label>

                </div>


                <div
                    *ngIf="!isDocumentEnvoye(code)"
                    class="ligne-with-button">

                    <button
                        type="button"
                        class="chgt-button obligatoire"
                        [disabled]="isEnvoiDocumentDisabled(code)"
                        (click)="onClickEnvoiDocument(code)">

                        {{ Constantes.ENVOI_ATTESTATION_ENVOYER_DOCUMENT_LIB }}

                    </button>

                </div>


                <div
                    *ngIf="isDocumentEnvoye(code)"
                    class="recapitulatif-bilan">

                    <div class="chgt-coche-verte"></div>

                    <span>
                        {{ getBilanEnvoi(code) }}
                    </span>

                </div>

            </div>

        </ng-container>


        <!-- TOUT TON CODE ACTUEL -->
        <ng-template #editionStandard>

            <div
                (click)="onClickVoir(code)"
                [class.disabled]="isActionDisabled(code)"
                [class.moins]="!isVoirPlus(code)"
                [class.plus]="isVoirPlus(code)"
                class="recapitulatif">

                <span class="recapitulatif-lib">

                    {{ getVoirLib(code) }}

                    <span
                        *ngIf="
                            code === Constantes.HAB_EDITION_ACR_SUPPRESSION_HABITATION
                            && !isDocumentEnvoye(code)
                        ">
                        {{ getAcrSuppressionSelectionLib() }}
                    </span>

                </span>

                <div
                    *ngIf="isDocumentEnvoye(code)"
                    class="recapitulatif-bilan">

                    <div class="chgt-coche-verte"></div>

                    <span>
                        {{ getBilanEnvoi(code) }}
                    </span>

                </div>

                <div class="fleche">

                    <div
                        [class.moins]="!isVoirPlus(code)"
                        [class.plus]="isVoirPlus(code)"
                        class="icon">
                    </div>

                </div>

            </div>

            <!-- ICI TU LAIS TOUS TES BLOCS ACTUELS -->
            <!-- Mandat -->
            <!-- Attestation scolaire -->
            <!-- Attestation habitation -->
            <!-- RC locative -->
            <!-- ACR suppression -->

        </ng-template>

    </div>

</ng-container>
