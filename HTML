<div
  class="total-row"
  [class.one-formule]="nbFormules === 1"
  [class.two-formules]="nbFormules === 2">

  <div class="total-label">
    TOTAL
  </div>

  <div
    class="total-formule"
    *ngIf="afficherFormuleConseillee">
    {{ totalFormuleConseillee }} €
  </div>

  <div
    class="total-formule"
    *ngIf="afficherFormulePersonnalisee">
    {{ totalFormulePersonnalisee }} €
  </div>
</div>
