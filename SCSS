.pack-row,
.total-row {
    display: grid;
    width: 100%;
    column-gap: 8px;
    box-sizing: border-box;
    align-items: center;

    &.two-formules {
        grid-template-columns: 40fr 30fr 30fr;
    }

    &.one-formule {
        grid-template-columns: 40fr 60fr;
    }
}

.col-adresse,
.col-formule,
.total-label,
.total-formule {
    min-width: 0;
    box-sizing: border-box;
}

.total-label {
    font-weight: 700;
}

.total-formule {
    width: 100%;
    text-align: center;
    margin: 0;
    padding: 0;
}
