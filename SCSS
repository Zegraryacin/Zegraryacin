private gereEnvoiDocumentOK(
    code: string,
    result: DataOutChgtadrhabModelInterface
): void {

    const edition = this.getEditionFromList(code)!;

    let nbDocuments = 0;

    switch (code) {

        case this.Constantes.HAB_EDITION_MODEL_RESILIATION:

            nbDocuments = 1;

            break;


        case this.Constantes.HAB_EDITION_ATTESTATION_SCOLAIRE:

            nbDocuments =
                this.listEnfants
                    .filter(e => e.selection)
                    .length;

            break;


        case this.Constantes.HAB_EDITION_ATTESTATION_HABITATION:

            nbDocuments = 1;

            break;


        case this.Constantes.HAB_EDITION_ATTESTATION_RC_LOCATIVE:

            nbDocuments =
                this.listLocations
                    .filter(l => l.selection)
                    .length;

            break;
    }


    const pluriel =
        nbDocuments > 1
            ? 's'
            : this.Constantes.STRING_VIDE;


    const typeEnvoiLib =
        this.Converter.getTranscoLibelle(
            this.Constantes.TRANSCO_TYPE_ENVOI_LIB,
            edition.canalEnvoi
        );


    if (
        nbDocuments > 0
        && typeEnvoiLib !==
           this.Constantes.REF_LIB_INDEFINI
    ) {

        edition.isEnvoyer = true;

        edition.isVoirPlus = true;

        edition.bilanEnvoi =
            nbDocuments
                .toString()
                .concat(' document')
                .concat(pluriel)
                .concat(' envoyé')
                .concat(pluriel)
                .concat(' par ')
                .concat(typeEnvoiLib);
    }


public isTerminerDisabled(): boolean {

    const editionsFermees =
        this.listEditions.every(
            edition => edition.isVoirPlus
        );

    const modeleHamonEnAttente =
        this.modeleResiliationSelectionne
        && !this.isDocumentEnvoye(
            this.Constantes.HAB_EDITION_MODEL_RESILIATION
        );

    return !(
        this.isSignatureEnvoye
        && editionsFermees
    )
    || modeleHamonEnAttente;
}

    this.spinner.hide();
}
