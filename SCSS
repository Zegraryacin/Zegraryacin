.total-row {
    margin-top: 30px;
    align-items: center;
}

/* =========================================================
   MÊME GRILLE POUR LES RISQUES + PACKS + TOTAL
   ========================================================= */

.pack-row,
.total-row {
    display: grid;
    width: 100%;
    column-gap: 8px;
    box-sizing: border-box;
    align-items: center;

    /* 2 formules :
       40% adresse
       30% conseillée
       30% personnalisée
    */
    &.two-formules {
        grid-template-columns:
            minmax(0, 40fr)
            minmax(0, 30fr)
            minmax(0, 30fr);
    }

    /* 1 seule formule :
       40% adresse
       60% formule
    */
    &.one-formule {
        grid-template-columns:
            minmax(0, 40fr)
            minmax(0, 60fr);
    }
}

/* Colonne de gauche : TOTAL */
.total-label {
    width: auto;
    min-width: 0;

    font-size: 14px;
    font-style: normal;
    line-height: normal;
}

/* Valeurs 0,00 € */
.total-row .col-select {
    width: 100%;
    min-width: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    text-align: center;
}

/* La colonne adresse ne doit plus imposer de flex */
.total-row .col-adresse {
    width: auto;
    min-width: 0;
}
